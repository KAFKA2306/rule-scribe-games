# Backend secrets - DO NOT COMMIT REAL VALUES
# Gemini API keys (round-robin load balancing)
# Use GEMINI_API_KEY_1, GEMINI_API_KEY_2, etc. for multiple keys.
# If only one key is configured, use GEMINI_API_KEY.
GEMINI_API_KEY_1=<gemini-api-key-1>
GEMINI_API_KEY_2=<gemini-api-key-2>
GEMINI_API_KEY_3=<gemini-api-key-3>

# Supabase server-side configuration. Never expose the service-role key to Vite/browser code.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>

# Supabase browser-safe configuration exposed by Vite
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<supabase-anon-or-publishable-key>

# SEO
NEXT_PUBLIC_BASE_URL=https://bodoge-no-mikata.vercel.app

# Optional
GEMINI_MODEL=models/gemini-3-flash-preview
AMAZON_TRACKING_ID=bodogemikata-22
