{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bodoge-no-mikata.vercel.app/schemas/curated-game-v1.json",
  "title": "ボドゲのミカタ game record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lifecycle_status",
    "slug",
    "work"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "lifecycle_status": {
      "enum": [
        "candidate",
        "curated"
      ]
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "work": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_title",
        "identity_status"
      ],
      "properties": {
        "canonical_title": {
          "type": "string",
          "minLength": 1
        },
        "identity_status": {
          "enum": [
            "verified",
            "needs_review",
            "unverified"
          ]
        }
      }
    },
    "preference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "candidate",
            "liked",
            "neutral",
            "disliked"
          ]
        },
        "priority": {
          "enum": [
            "highest",
            "high",
            "normal"
          ],
          "default": "normal"
        },
        "played": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "rule_version",
        "revision"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "rule_version": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "game": {
      "type": "object",
      "required": [
        "slug",
        "title",
        "summary",
        "source_url",
        "source_revision",
        "generated_from_source_revision"
      ],
      "properties": {
        "slug": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": "string",
          "pattern": "^https://"
        },
        "source_revision": {
          "type": "string",
          "minLength": 1
        },
        "generated_from_source_revision": {
          "type": "string",
          "minLength": 1
        },
        "rules_content": false,
        "setup_summary": false,
        "gameplay_summary": false,
        "end_game_summary": false
      }
    },
    "ruleset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language_code",
        "edition_label",
        "revision_label",
        "platform",
        "publisher_name",
        "nodes"
      ],
      "properties": {
        "language_code": {
          "type": "string",
          "minLength": 2,
          "maxLength": 35
        },
        "edition_label": {
          "type": "string",
          "minLength": 1
        },
        "revision_label": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "publisher_name": {
          "type": "string",
          "minLength": 1
        },
        "coverage": {
          "enum": [
            "core",
            "full"
          ],
          "default": "core"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rule_id",
              "node_type",
              "normalized_statement",
              "sequence"
            ],
            "properties": {
              "rule_id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$"
              },
              "node_type": {
                "enum": [
                  "phase",
                  "turn",
                  "action",
                  "condition",
                  "effect",
                  "setup",
                  "scoring",
                  "round_end",
                  "game_end",
                  "victory",
                  "exception",
                  "targeting",
                  "conflict_resolution",
                  "variant"
                ]
              },
              "normalized_statement": {
                "type": "string",
                "minLength": 1
              },
              "sequence": {
                "type": "integer",
                "minimum": 0
              },
              "section_heading": {
                "type": "string",
                "minLength": 1
              },
              "page_number": {
                "type": "integer",
                "minimum": 1
              },
              "external_reference": {
                "type": "string",
                "minLength": 1
              }
            },
            "anyOf": [
              {
                "required": [
                  "section_heading"
                ]
              },
              {
                "required": [
                  "page_number"
                ]
              },
              {
                "required": [
                  "external_reference"
                ]
              }
            ]
          }
        },
        "source_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]{2,191}$"
        },
        "source_type": {
          "type": "string",
          "minLength": 1,
          "default": "publisher_rulebook"
        },
        "authority": {
          "enum": [
            "official_publisher",
            "official_localizer",
            "publisher_authorized",
            "designer_publisher"
          ],
          "default": "official_publisher"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "lifecycle_status": {
            "const": "candidate"
          }
        }
      },
      "then": {
        "required": [
          "preference"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "lifecycle_status": {
            "const": "curated"
          }
        }
      },
      "then": {
        "required": [
          "source",
          "game"
        ]
      }
    }
  ]
}
